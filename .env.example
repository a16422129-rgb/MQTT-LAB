# Copy this file to .env and replace every placeholder with the matching
# Mosquitto account name and password. Do not commit .env.
MQTT_CAMERA01_USERNAME=replace-with-camera01-username
MQTT_CAMERA01_PASSWORD=replace-with-camera01-password
MQTT_CAMERA02_USERNAME=replace-with-camera02-username
MQTT_CAMERA02_PASSWORD=replace-with-camera02-password
MQTT_DASHBOARD_USERNAME=replace-with-dashboard-username
MQTT_DASHBOARD_PASSWORD=replace-with-dashboard-password
MQTT_MONITOR_USERNAME=replace-with-monitor-username
MQTT_MONITOR_PASSWORD=replace-with-monitor-password
